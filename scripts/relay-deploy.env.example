# 远程控制中继的部署配置。复制一份再填（不要提交 relay-deploy.env）：
#   copy scripts\relay-deploy.env.example scripts\relay-deploy.env

# SSH 登录：用户@服务器
HOST=root@192.168.1.10

# SSH 端口，默认 22
SSH_PORT=22

# 中继在服务器上的目录
REMOTE_DIR=/opt/allai-relay

# 中继监听的端口（只监听服务器本机，1Panel 反代到 http://127.0.0.1:这个端口）
RELAY_PORT=30778

# 部署用的 SSH 私钥。留空就用 %USERPROFILE%\.ssh\allai_relay_deploy，
# 第一次部署时自动生成并装到服务器上（那一步要输一次服务器密码，之后就不用了）。
# 同一台服务器上已经有能免密登录的钥匙，也可以直接复用，例如：
#   SSH_KEY=%USERPROFILE%\.ssh\wordtrail_deploy
SSH_KEY=
